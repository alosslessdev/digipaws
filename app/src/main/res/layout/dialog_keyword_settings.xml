<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/redirection"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="?android:attr/textColorSecondary"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_redirect_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/redirection_url"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/configuration"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="?android:attr/textColorSecondary"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_search_recursively"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_recursively_for_blocked_keywords_on"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_match_substrings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/also_match_inside_longer_words_and_links"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_block_unsupported_browsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/block_all_browsers_except_supported_ones"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_select_ignored_apps"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_ignored_apps"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/time_tracking"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="?android:attr/textColorSecondary"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_time_tracking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_time_tracking"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/layout_time_tracking_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/clustering_threshold"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_clustering_threshold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/clustering_threshold"
                    android:inputType="number"
                    android:maxLines="1"
                    android:text="5" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
